[Unit]
Description=tlsgate TLS Fingerprint Proxy
After=network.target

[Service]
# Type=notify + NotifyAccess=all so a zero-downtime upgrade works: after a
# tableflip handoff the process that ends up serving is a child of the original
# main PID, and it reports its own PID so systemd tracks the new process.
# NotifyAccess=all is required because that notification arrives from a process
# systemd does not yet consider the main one.
Type=notify
NotifyAccess=all
User=tlsgate
Group=tlsgate
{# routes: list of {listen, backend}. Falls back to the mail defaults so
   existing inventories that set imap_backend/smtp_backend keep working. #}
ExecStart=/usr/local/bin/tlsgate serve \
{% for r in routes | default([{'listen': imap_listen | default('[::]:993'), 'backend': imap_backend}, {'listen': smtp_listen | default('[::]:465'), 'backend': smtp_backend}]) %}
  --route {{ r.listen }}={{ r.backend }} \
{% endfor %}
  --db /var/lib/tlsgate/db.sqlite \
  --config {{ tlsgate_config | default('/etc/tlsgate/config.json') }} \
  --fingerprint {{ fingerprint | default('ja3') }} \
  {% if reset_fingerprints | default(false) | bool %}--reset-fingerprints {% endif %}{% if allow_unknown | default(false) | bool %}--allow-unknown{% endif %}

# SIGHUP starts a graceful upgrade: tableflip re-execs the newly installed
# binary and hands it the listening sockets, and this process keeps serving its
# existing connections until they drain. Without it, deploying tlsgate drops
# live IMAP and SMTP sessions on the mail host.
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5

# A departing process may hold long-lived mail sessions for up to
# --drain-timeout. systemd must not SIGKILL it out from under them on stop.
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Headroom above 2x maxConcurrentConns (1024) for client+backend sockets
# plus the SQLite database, WAL, and journal handles.
LimitNOFILE=8192

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateDevices=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/tlsgate

[Install]
WantedBy=multi-user.target
